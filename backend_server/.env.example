# Example environment variables for backend_server
# Copy to ".env" and set appropriate values

# PUBLIC_INTERFACE
# BACKEND_JWT_SECRET is used for JWT signing/verification in the backend.
# In-memory storage does not use it directly, but APIs may require it later.
BACKEND_JWT_SECRET=replace-with-a-strong-secret
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
